# Copy to server/.env (gitignored) and fill in. Never commit the real file.

# Password the phone app sends on every request. Use 12+ random characters.
SIDEKICK_APP_PASSWORD=

# Public https URL that reaches port 7790 (your ngrok URL). Claude calls back here.
SIDEKICK_PUBLIC_URL=

# Ports (defaults shown). 7781 = Chrome extension, local only. 7790 = expose via ngrok.
SIDEKICK_APP_PORT=7790
SIDEKICK_LEGACY_PORT=7781

# Where the queue JSON files live. Default: server/data (gitignored).
# To keep using the extension's existing files, point this at tools/x-reply-extension/data
SIDEKICK_DATA_DIR=

# Armory (same values as guides/armory-api-handoff.md section 1).
ARMORY_URL=
ARMORY_USER=
ARMORY_PASS=

# Optional: if ngrok points at 7790 instead of Armory, set Armory's local address here
# and every non-sidekick path is forwarded to it, so the old Armory URL keeps working.
ARMORY_PASSTHROUGH=

# Claude Code routine API trigger (claude.ai/code/routines -> your routine -> API trigger).
ROUTINE_FIRE_URL=
ROUTINE_TOKEN=

# Optional: extra browser origins allowed to call the API (comma separated).
SIDEKICK_ALLOWED_ORIGINS=

# LinkedIn accepts, read from LinkedIn's "accepted your invitation" emails.
# The Gmail the LinkedIn account uses, and a Gmail app password for it
# (myaccount.google.com/apppasswords; needs 2-Step Verification). Read-only.
LI_ACCEPT_EMAIL=
LI_ACCEPT_APP_PASSWORD=
LI_ACCEPT_EVERY_MIN=10
LI_ACCEPT_WRITE_EVERY_MIN=120
